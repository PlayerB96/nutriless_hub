
// ░░░ DATOS DE CONEXIÓN Y GENERADOR ░░░

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 🧍 MODELOS DE AUTENTICACIÓN Y USUARIO 
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  // Relaciones del usuario
  UserFood UserFood[] // Alimentos creados por el usuario
  accounts Account[]
  sessions Session[]
  recipes  Recipe[] // Recetas creadas por el usuario
  patients Patient[] // Pacientes creados por el usuario
}

model Account {
  id                Int     @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// 🍽️ ALIMENTOS CREADOS POR USUARIO 
model Food {
  id        Int      @id @default(autoincrement())
  name      String
  category  String
  createdAt DateTime @default(now())
  userId    Int
  imageUrl  String?

  // Relaciones
  nutritionDetails  NutritionDetail[]
  householdMeasures HouseholdMeasure[]
  UserFood          UserFood[]
}

model UserFood {
  id     Int      @id @default(autoincrement())
  userId Int
  foodId Int
  date   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  food Food @relation(fields: [foodId], references: [id])
}

model NutritionDetail {
  id       Int    @id @default(autoincrement())
  foodId   Int
  nutrient String
  value    Float
  unit     String

  food Food @relation(fields: [foodId], references: [id])

  @@unique([foodId, nutrient], name: "foodId_nutrient")
}

model HouseholdMeasure {
  id          Int    @id @default(autoincrement())
  foodId      Int
  description String
  quantity    Float
  weightGrams Float

  food Food @relation(fields: [foodId], references: [id])
}

// 📚 CATEGORÍAS Y NUTRIENTES OPCIONALES
model CategoryFood {
  id   Int    @id @default(autoincrement())
  name String @unique
}

model OptionalNutrient {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 📖 RECETAS Y DETALLES
model Recipe {
  id         Int           @id @default(autoincrement())
  name       String
  tags       String[]
  portions   Int
  prepTime   Int
  cookTime   Int?
  difficulty String
  isPublic   Boolean       @default(false)
  createdAt  DateTime      @default(now())
  detail     RecipeDetail?

  image  String?
  userId Int?
  User   User?   @relation(fields: [userId], references: [id])
}

model RecipeDetail {
  id           Int      @id @default(autoincrement())
  recipeId     Int      @unique
  instructions String[]

  recipeIngredients RecipeIngredient[]

  recipe            Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  TraditionalFood   TraditionalFood? @relation(fields: [traditionalFoodId], references: [id])
  traditionalFoodId Int?
}

  // 🧾 ALIMENTOS TRADICIONALES DEL SISTEMA
  model TraditionalFood {
    id        Int      @id @default(autoincrement())
    name      String
    category  String
    origin    String?
    imageUrl  String?
    createdAt DateTime @default(now())

    nutrients         TraditionalNutrient[]
    recipeDetails     RecipeDetail[]
    householdMeasures TraditionalHouseholdMeasure[]
    RecipeIngredient  RecipeIngredient[]
  }

  model TraditionalNutrient {
    id        Int      @id @default(autoincrement())
    foodId    Int
    nutrient  String
    value     Float
    unit      String
    createdAt DateTime @default(now())

    food TraditionalFood @relation(fields: [foodId], references: [id], onDelete: Cascade)
  }

  model TraditionalHouseholdMeasure {
    id          Int    @id @default(autoincrement())
    foodId      Int
    description String
    quantity    Float
    weightGrams Float

    food             TraditionalFood    @relation(fields: [foodId], references: [id], onDelete: Cascade)
    RecipeIngredient RecipeIngredient[]

    @@unique([foodId, description, quantity])
  }

  model RecipeIngredient {
    id             Int   @id @default(autoincrement())
    recipeDetailId Int
    foodId         Int
    medidaId       Int
    cantidad       Float

    recipeDetail RecipeDetail                @relation(fields: [recipeDetailId], references: [id], onDelete: Cascade)
    food         TraditionalFood             @relation(fields: [foodId], references: [id], onDelete: Cascade)
    medida       TraditionalHouseholdMeasure @relation(fields: [medidaId], references: [id], onDelete: Cascade)

    @@unique([recipeDetailId, foodId])
  }
  

// 👤 PATIENTS FOR NUTRITION
model Patient {
  id             Int      @id @default(autoincrement())
  userId         Int      // Nutritionist who owns the patient
  name           String
  lastName       String
  gender         String   // M / F / O
  birthDate      DateTime
  email          String?  @unique
  phone          String?
  height         Float?   // Height in cm
  weight         Float?   // Weight in kg

  maritalStatus  String?  // Single, Married, etc.
  occupation     String?  // Job / profession
  address        String?  // Patient address
  photo          String?  // Image URL or file path

  createdAt      DateTime @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  detail         PatientDetail?
  images         PatientImage[]
}

model PatientDetail {
  id                   Int             @id @default(autoincrement())
  patientId            Int             @unique
  goal                 String?
  goalComment          String?
  motivation           Int?            // 1–10
  activityLevel        String?
  alcoholFrequency     String?
  alcoholTypes         String[]        @default([])
  alcoholUse           Boolean?        @default(false)
  coffeeFrequency      Int?
  coffeeUse            Boolean?        @default(false)
  sleepHours           Float?
  sleepQuality         Int?
  stressLevel          String?
  stressReason         String?
  supplementTypes      String[]        @default([])
  supplementsFrequency Int?
  supplementsUse       Boolean?        @default(false)
  tobaccoFrequency     String?
  tobaccoUse           Boolean?        @default(false)
  dietType             String?
  dietaryConditions    String[]        @default([])
  glutenIntolerant     Boolean?        @default(false)
  lactoseIntolerant    Boolean?        @default(false)
  hadPreviousDiet      Boolean?        @default(false)
  mealsPerDay          Int?
  waterLitersPerDay    Float?
  currentConditions           String[]
  familyPathologicalHistory String[]        @default([])
  healthComments              String?
  intestinalCondition         String?
  medications                 String[]
  pathologicalHistory         String[]
  preferredFoods              String[]        @default([])
  dislikedFoods               String[]        @default([])
  foodAllergies               String[]        @default([])
  referralSource              String?
  preAppointmentComment       String?
  foodFrequencies      FoodFrequency[]

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model FoodFrequency {
  id              Int           @id @default(autoincrement())
  patientDetailId Int
  foodGroup       String
  timesPerWeek    Int?

  patientDetail PatientDetail @relation(fields: [patientDetailId], references: [id], onDelete: Cascade)

  @@unique([patientDetailId, foodGroup])
}

model PatientImage {
  id        Int      @id @default(autoincrement())
  patientId Int
  title     String   @default("")
  date      DateTime @default(now())
  imageKey  String   // R2 object key
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
}
